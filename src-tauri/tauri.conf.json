{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Dashboard",
  "version": "0.1.0",
  "identifier": "dev.codex.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Codex Dashboard",
      "width": 1280,
      "height": 800,
      "minWidth": 900,
      "minHeight": 620,
      "decorations": true,
      "transparent": false
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
